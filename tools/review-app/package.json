    "test": "vp test run",
    "check": "panda codegen && vp check",
    "fix": "panda codegen && vp check --fix",
    "verify": "pnpm check && pnpm test && pnpm build"
  },
  "dependencies": {
    "@tanstack/solid-router": "1.170.32",
    "@tanstack/solid-start": "1.168.49",
    "sharp": "^0.35.4",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@pandacss/dev": "^1.12.1",
    "@types/node": "^26.4.1",
    "postcss": "^8.5.28",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vite-plugin-solid": "^2.11.14",
    "vite-plus": "0.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
