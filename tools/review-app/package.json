{
  "name": "@nc/review-app",
  "version": "0.1.0",
  "private": true,
  "description": "Visual review app: compare rendered configurations side by side, in place.",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "scripts": {
    "prepare": "panda codegen",
    "dev": "panda codegen && node scripts/dev.mjs",
